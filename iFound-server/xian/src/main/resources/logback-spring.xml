<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--日志文件的保存路径,首先查找系统属性-Dlog.dir,如果存在就使用其；否则，在当前目录下创建名为iFoundlogs目录做日志存放的目录 -->
    <property name="home" value="${log.dir:-iFoundlogs}" />
    <property name="appName" value="iFound" />
    <!-- 日志输出格式 -->
    <property name="pattern" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %p [Class:%logger{1}->Thread:%t] %m %n" />

    <!-- ==================== 控制台输出 ==================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${pattern}</pattern>
        </encoder>
    </appender>

    <!-- ==================== 按天滚动文件 ==================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${home}/${appName}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档文件名：xian-ai.2026-07-29.0.log -->
            <fileNamePattern>${home}/${appName}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单文件上限 10MB（同一天日志超大会再次切） -->
            <maxFileSize>10MB</maxFileSize>
            <!-- 保留 7 天历史 -->
            <maxHistory>7</maxHistory>
            <!-- 所有归档总大小不超过 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${pattern}</pattern>
        </encoder>
    </appender>

    <!-- ==================== 日志级别 ==================== -->
    <!-- 具体包级别（com.sysware、mapper 等）由 application.yml 的 logging.level 控制 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
